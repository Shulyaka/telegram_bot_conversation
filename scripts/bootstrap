#!/bin/sh

# script/bootstrap: Install/update all dependencies required to run the project

set -eu

cd "$(dirname "$0")/.."

case "${1:-}" in
  "") FULL_INSTALL=false ;;
  --full) FULL_INSTALL=true ;;
  *) echo "Usage: scripts/bootstrap [--full]" >&2; exit 2 ;;
esac

echo "==> Checking for uv..."
if ! command -v uv >/dev/null 2>&1; then
  echo "UV not found, installing..."
  if ! command -v pipx >/dev/null 2>&1; then
    python3 -m pip install uv
  else
    pipx install uv
  fi
fi

HA_VERSION=${HA_VERSION:-hacs}
if [ "$HA_VERSION" = "hacs" ]; then
  HA_VERSION=$(python3 -c 'import json; print(json.load(open("hacs.json"))["homeassistant"])')
elif [ "$HA_VERSION" = "latest" ]; then
  HA_VERSION=$(curl -fsSL https://pypi.org/pypi/homeassistant/json | python3 -c 'import json, sys; print(json.load(sys.stdin)["info"]["version"])')
fi

if [ -z "$HA_VERSION" ]; then
  echo "Error: Could not determine Home Assistant version. Please set HA_VERSION." >&2
  exit 1
fi

echo "==> Installing dependencies..."

set -- --upgrade
if [ -z "${VIRTUAL_ENV:-}" ]; then
  echo "No virtual environment detected, installing globally..."
  set -- "$@" --system
else
  echo "Virtual environment detected: $VIRTUAL_ENV"
fi

tmpdir=$(mktemp -d)
trap 'rm -rf "$tmpdir"' EXIT

echo "Fetching Home Assistant dependencies for version ${HA_VERSION}..."
HA_CORE_BASE_URL="https://raw.githubusercontent.com/home-assistant/core/${HA_VERSION}"
mkdir -p "$tmpdir/homeassistant"
curl -fsSL "${HA_CORE_BASE_URL}/homeassistant/package_constraints.txt" -o "$tmpdir/homeassistant/package_constraints.txt"  # constraints for requirements files
curl -fsSL "${HA_CORE_BASE_URL}/requirements_all.txt" -o "$tmpdir/requirements_all.txt"
sed -e 's/^-r /#-r /' "$tmpdir/requirements_all.txt" > "$tmpdir/constraints_all.txt"

case "$HA_VERSION" in
  # prerelease: contains a/b/rc suffix
  *[0-9]a[0-9]*|*[0-9]b[0-9]*|*[0-9]rc[0-9]*)
    set -- "$@" --prerelease allow
    HA_REQUIREMENT="homeassistant==${HA_VERSION}"
    PYTEST_HA_REQUIREMENT="pytest-homeassistant==${HA_VERSION}"
    ;;
  # git ref: contains characters other than digits and dots
  *[!0-9.]*)
    HA_REQUIREMENT="homeassistant @ git+https://github.com/home-assistant/core.git@${HA_VERSION}"
    PYTEST_HA_REQUIREMENT="pytest-homeassistant @ git+https://github.com/home-assistant/core.git@${HA_VERSION}#subdirectory=packages/pytest-homeassistant"
    set -- "$@" --reinstall-package homeassistant --reinstall-package pytest-homeassistant
    ;;
  # release: digits and dots only
  *)
    HA_REQUIREMENT="homeassistant==${HA_VERSION}"
    PYTEST_HA_REQUIREMENT="pytest-homeassistant==${HA_VERSION}"
    ;;
esac

python3 scripts/collect-integration-requirements "$HA_VERSION" > "$tmpdir/integration-requirements.txt"
printf '%s\n' "$HA_REQUIREMENT" "$PYTEST_HA_REQUIREMENT" > "$tmpdir/ha-requirements.txt"
printf -- '-r %s\n' "$tmpdir/integration-requirements.txt" >> "$tmpdir/ha-requirements.txt"

if [ "$FULL_INSTALL" = true ]; then
  curl -fsSL "${HA_CORE_BASE_URL}/requirements.txt" -o "$tmpdir/requirements.txt"  # required by requirements_all.txt
  curl -fsSL "${HA_CORE_BASE_URL}/requirements_test_pre_commit.txt" -o "$tmpdir/requirements_test_pre_commit.txt"  # required by requirements_test.txt
  curl -fsSL "${HA_CORE_BASE_URL}/requirements_test.txt" -o "$tmpdir/requirements_test.txt"
  printf -- '-r %s\n' "$tmpdir/requirements_all.txt" "$tmpdir/requirements_test.txt" >> "$tmpdir/ha-requirements.txt"
fi

uv pip install "$@" \
  --constraint "$tmpdir/homeassistant/package_constraints.txt" \
  --constraint "$tmpdir/constraints_all.txt" \
  --requirement requirements.txt \
  --requirement "$tmpdir/ha-requirements.txt"

# The two test plugins provide overlapping fixtures and cannot coexist.
if [ -z "${VIRTUAL_ENV:-}" ]; then
  uv pip uninstall --system pytest-homeassistant-custom-component
else
  uv pip uninstall pytest-homeassistant-custom-component
fi

echo "==> Installing prek hooks..."
pre-commit uninstall
prek install

echo "==> Bootstrap completed!"
